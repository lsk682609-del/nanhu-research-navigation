#!/usr/bin/env python3
"""Installed entry point for plan_env drivable-area inference."""

from pathlib import Path
import sys


script_path = Path(__file__).absolute()
installed_module_dir = script_path.parent
source_module_dir = script_path.parent.parent / "python"
for module_dir in (installed_module_dir, source_module_dir):
    if (module_dir / "plan_env_perception").is_dir():
        sys.path.insert(0, str(module_dir))
        break

from plan_env_perception.ros_node import main  # noqa: E402


if __name__ == "__main__":
    install_prefix = script_path.parents[2]
    default_weight = install_prefix / "share" / "plan_env" / "models" / "medium.pth"
    if not default_weight.is_file():
        default_weight = script_path.parent.parent / "models" / "medium.pth"
    main(str(default_weight))
