<?xml version='1.0'?>
<sdf version='1.7'>
  <world name='default'>
    <!-- Capstone C1：L 形走廊 + 两扇 0.72 m 窄门 + 15° 坡道
         走廊 A（横向）：x 1..13, y 2..5，出生点 (2, 3.5)
         走廊 B（纵向）：x 9..13, y 5..14，目标 (11, 13.3)
         门 1 门心 (6.5, 3.5)，门柱沿 y；门 2 门心 (11, 11.8)，门柱沿 x
         坡道沿 y 6..11，宽 3.6 m，15° 上坡 + 1 m 平台 + 下坡 -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ===== L 形走廊外墙 ===== -->
    <model name="wall_a_south">
      <static>true</static>
      <pose>7 2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.0 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0 0.15 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_a_west">
      <static>true</static>
      <pose>1 3.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 3.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 3.15 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 走廊 A 的内侧北墙，到 x=9 为止，留出转入走廊 B 的转角 -->
    <model name="wall_a_north">
      <static>true</static>
      <pose>5 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.15 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.15 0.15 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 走廊 A 与 B 共用的东墙 -->
    <model name="wall_east">
      <static>true</static>
      <pose>13 8 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 12.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 12.15 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_b_west">
      <static>true</static>
      <pose>9 9.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 9.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 9.15 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_b_north">
      <static>true</static>
      <pose>11 14 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.15 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.15 0.15 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 门 1：门心 (6.5, 3.5)，缝 0.72 m（y 3.14..3.86） ===== -->
    <model name="capstone_gate1_south">
      <static>true</static>
      <pose>6.5 2.64 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 1.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 1.0 2.0</size></box></geometry>
          <material><ambient>0.9 0.8 0.2 1</ambient><diffuse>0.9 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="capstone_gate1_north">
      <static>true</static>
      <pose>6.5 4.36 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 1.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 1.0 2.0</size></box></geometry>
          <material><ambient>0.9 0.8 0.2 1</ambient><diffuse>0.9 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 门 2：门心 (11, 11.8)，缝 0.72 m（x 10.64..11.36） ===== -->
    <model name="capstone_gate2_west">
      <static>true</static>
      <pose>10.14 11.8 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.15 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.15 2.0</size></box></geometry>
          <material><ambient>0.9 0.8 0.2 1</ambient><diffuse>0.9 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="capstone_gate2_east">
      <static>true</static>
      <pose>11.86 11.8 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.15 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.15 2.0</size></box></geometry>
          <material><ambient>0.9 0.8 0.2 1</ambient><diffuse>0.9 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 15° 坡道：沿 +y 方向 0..5 m，宽 3.6 m（x 9.2..12.8） =====
         滚转 90° 把 profile 抬到 z，再偏航 90° 让 run 沿 y、挤出宽度沿 x -->
    <model name="capstone_ramp">
      <static>true</static>
      <pose>9.2 6 0 1.5708 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <polyline>
              <height>3.6</height>
              <point>0 0</point>
              <point>2 0.5359</point>
              <point>3 0.5359</point>
              <point>5 0</point>
            </polyline>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <polyline>
              <height>3.6</height>
              <point>0 0</point>
              <point>2 0.5359</point>
              <point>3 0.5359</point>
              <point>5 0</point>
            </polyline>
          </geometry>
          <material><ambient>0.4 0.6 0.8 1</ambient><diffuse>0.4 0.6 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
